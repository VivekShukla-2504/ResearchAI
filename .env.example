# Local MongoDB; this example contains no credentials.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=researchpaper_ai
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500

# Paths are relative to the project root unless absolute.
CLEANED_DATA_PATH=data/processed/papers_clean.csv
MODEL_ARTIFACT_PATH=artifacts/recommender.joblib

# Comma-separated local Vite origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
