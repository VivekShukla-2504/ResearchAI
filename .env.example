# Local MongoDB; this example contains no credentials.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=researchpaper_ai
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500

# Paths are relative to the project root unless absolute.
CLEANED_DATA_PATH=data/processed/papers_clean.csv
MODEL_ARTIFACT_PATH=artifacts/recommender.joblib

# Comma-separated local Vite origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_DAYS=7

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP Automated Email Dispatch (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=your_email@gmail.com
OTP_TTL_MINUTES=10
